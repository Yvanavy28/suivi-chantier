# Variables d'environnement nécessaires en production (Netlify > Site settings
# > Environment variables) et en local (fichier .env, non commité).

# Client (préfixe VITE_ obligatoire pour être exposé au navigateur) :
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fonction serverless Netlify (netlify/functions/extract-pdf.js) — ne JAMAIS
# préfixer avec VITE_, sinon la clé se retrouverait dans le bundle client :
ANTHROPIC_API_KEY=
